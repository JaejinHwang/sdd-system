{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "declaration": true,
    "paths": {
      "@/*": ["./*"],
      "@scripts/*": ["./scripts/*"],
      "@templates/*": ["./templates/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "scripts/**/*.ts",
    "cli/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}